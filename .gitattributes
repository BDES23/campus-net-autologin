# 统一换行符，避免 Windows / Linux 之间反复出现"整个文件都改了"的假 diff
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.ini   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf

# Windows 脚本保持 CRLF，否则 PowerShell 5.1 下可能出问题
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# 二进制文件不要做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.gif   binary
